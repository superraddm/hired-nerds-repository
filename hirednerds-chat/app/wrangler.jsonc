/**
 * jofdavies.com API Worker.
 * Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Secrets (set with `wrangler secret put NAME`, never committed):
 *   OPENAI_API_KEY      embeddings and chat completions
 *   POSTMARK_API_TOKEN  contact form email
 *   INGEST_TOKEN        bearer token for /api/ingest and /api/admin/delete (24+ characters)
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app",
  "main": "src/index.js",
  "compatibility_date": "2025-12-11",

  // The public workers.dev address is switched off: the API is reachable only through jofdavies.com.
  "workers_dev": false,

  "routes": [
    { "pattern": "jofdavies.com/api*", "zone_name": "jofdavies.com" },
    { "pattern": "jofdavies.com/download/cv*", "zone_name": "jofdavies.com" }
  ],

  // KV: holds the daily chat counter (key chat-count:YYYY-MM-DD). The binding keeps its original name.
  "kv_namespaces": [
    { "binding": "PDF_REQUESTS", "id": "dd88bd4a3be34411a98198ca1b284214" }
  ],

  // Vectorize: the chatbot's library. The November 2026 rebuild uses a fresh index so the old one stays as a rollback.
  //   wrangler vectorize create jof-library-2026-11 --dimensions=1536 --metric=cosine
  "vectorize": [
    { "binding": "DOC_INDEX", "index_name": "jof-library-2026-11" }
  ],

  // Per-IP rate limits (Workers Rate Limiting API). period is 10 or 60 seconds.
  "ratelimits": [
    { "name": "CHAT_LIMITER", "namespace_id": "2611", "simple": { "limit": 12, "period": 60 } },
    { "name": "CONTACT_LIMITER", "namespace_id": "2612", "simple": { "limit": 3, "period": 60 } }
  ],

  "observability": { "enabled": true },

  // Public (non-secret) settings
  "vars": {
    "OPENAI_API_BASE": "https://api.openai.com/v1",
    "OPENAI_EMBEDDING_MODEL": "text-embedding-3-small",
    "OPENAI_CHAT_MODEL": "gpt-4.1-mini",
    "CHAT_DAILY_CAP": "400"
  }
}
