/* Controls answer the finger LIFTING on them, not the browser's "click": Android Chrome swallows the click of a tap that follows
   a fast flick on the sheet (it reads the tap as "stop the fling"), so after flicking paint or a marble the next tap on a tool
   often did nothing. A real click (keyboard, assistive tech) still works; one that merely echoes a handled lift is ignored. */
let lastHandledPress=-Infinity;
document.addEventListener('click',e=>{if(e.detail>0&&performance.now()-lastHandledPress<600){lastHandledPress=-Infinity;e.preventDefault();e.stopImmediatePropagation();}},true);
function onPress(root, handler){ let downOn = null; const pick = e => e.target.closest ? e.target.closest('button,a') : null;
  root.addEventListener('pointerdown', e => { downOn = pick(e); });
  root.addEventListener('pointerup', e => { const b = pick(e); if (b && b === downOn && !b.disabled){ lastHandledPress = performance.now(); handler(e, b); } downOn = null; });
  root.addEventListener('pointercancel', () => { downOn = null; });
  root.addEventListener('click', e => {const b = pick(e); if (b && !b.disabled) handler(e, b); }); }
const setIcon = (el, name) => { el.innerHTML = ICONS[name]; };
function showSound(){
  const muted=sound?.muted,unavailable=!sound||soundState==='unavailable',b=$('#sound');
  b.innerHTML=I('<path d="M5 12h6l7-6v20l-7-6H5z" fill="#c7dcca"/>'+(muted?'<path d="m23 12 6 8m0-8-6 8"/>':'<path d="M23 11q5 5 0 10M26 7q8 9 0 18"/>'));
  b.setAttribute('aria-pressed',String(!muted&&!unavailable));
  b.setAttribute('aria-label',unavailable?'Sound unavailable. Tap to retry.':muted?'Sound off. Tap to turn on.':'Sound on. Tap to mute.');
  b.title=b.getAttribute('aria-label');
}
onPress($('#sound'),()=>{if(!sound)return;if(soundState==='unavailable'){sound.unlock(true);return;}sound.setMuted(!sound.muted);});
showSound();
