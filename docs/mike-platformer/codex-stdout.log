/* ---------- the sheet of paper ----------
   ONE sheet size on every device, for the whole life of a picture: SHEET_W x SHEET_H bitmap pixels. It is never re-made to suit
   a screen and never re-drawn on a resize (that is what shrank the picture in the first lab). What dictates the size is the
   weakest target: the iPad 5 and Safari's cap on canvas memory. 1600x1200 is 7.7 MB, and the sheet plus four Undo copies is
   about 38.4 MB at rest (one extra temporary snapshot during a gesture or history swap). Every mark is sized in sheet pixels.

   The view is only a CSS transform of that bitmap:
     turn   the sheet behaves like real paper lying on the device: when the device is turned, the sheet turns with it
            and its long side stays along the device's long side. The browser's orientation angle is used when it has
            one; when it has not, the shape of the space decides. Nothing here needs a lock, a sensor or an install.
     zoom   two fingers pinch and carry the sheet (mouse: wheel). Zoom 1 shows the whole sheet, so pinching all the way
            out is always the way home. Pinch and carry are the only ways to move around the sheet. */
const SHEET_W = 1600, SHEET_H = 1200, ZMAX = 5;
const GEO = {cx:0, cy:0, sw:1, sh:1, fit:1, s:1}, VIEW = {z:1, tx:0, ty:0, r:0};
const mod = a => ((a % 360) + 360) % 360;
const rawAngle = () => { const a = (screen.orientation && typeof screen.orientation.angle === 'number') ? screen.orientation.angle : (typeof window.orientation === 'number' ? window.orientation : null); return a == null ? null : mod(a); };
let A0 = null, R0 = null;
function newPaper(){
  putAway(); W = SHEET_W; H = SHEET_H; DPR = 1; unit = Math.min(W, H) / 700; undoStack.length = 0;
  paper.style.width = W + 'px'; paper.style.height = H + 'px'; paint.width = W; paint.height = H;
}
function place(){
  app.classList.toggle('narrow', Math.min(window.innerWidth, window.innerHeight) < 560);
  if (!W) newPaper();
  const b = stage.getBoundingClientRect(), A = rawAngle(); GEO.sw = Math.max(50, b.width); GEO.sh = Math.max(50, b.height); GEO.cx = b.left + b.width / 2; GEO.cy = b.top + b.height / 2;
  if (R0 == null){ R0 = GEO.sw >= GEO.sh ? 0 : 90; A0 = A; }                                  // how the sheet first lay on the device
  VIEW.r = (A == null || A0 == null) ? (GEO.sw >= GEO.sh ? 0 : 90) : mod(R0 - (A - A0));       // device turned one way = sheet turns the other way in the window, i.e. stays put on the glass
  const odd = VIEW.r % 180 !== 0; GEO.fit = Math.min(GEO.sw / (odd ? H : W), GEO.sh / (odd ? W : H)); applyView();
}
function applyView(){
  const odd = VIEW.r % 180 !== 0, sc = GEO.fit * VIEW.z, mx = Math.max(0, (odd ? H : W) * sc / 2 - GEO.sw / 2), my = Math.max(0, (odd ? W : H) * sc / 2 - GEO.sh / 2);
  VIEW.tx = clamp(VIEW.tx, -mx, mx); VIEW.ty = clamp(VIEW.ty, -my, my); GEO.s = sc;            // the sheet can never be carried off the screen
  paper.style.transform = `translate(-50%,-50%) translate(${VIEW.tx}px,${VIEW.ty}px) rotate(${VIEW.r}deg) scale(${sc})`;
  $('#fit').hidden = VIEW.z < 1.02; showPerf();
}
function toSheet(sx, sy){ const a = -VIEW.r * Math.PI / 180, c = Math.cos(a), n = Math.sin(a), dx = sx - GEO.cx - VIEW.tx, dy = sy - GEO.cy - VIEW.ty;
  return {x: (dx * c - dy * n) / GEO.s + W / 2, y: (dx * n + dy * c) / GEO.s + H / 2}; }
function toScreen(x, y){ const a = VIEW.r * Math.PI / 180, c = Math.cos(a), n = Math.sin(a), qx = (x - W / 2) * GEO.s, qy = (y - H / 2) * GEO.s;
  return {x: GEO.cx + VIEW.tx + qx * c - qy * n, y: GEO.cy + VIEW.ty + qx * n + qy * c}; }
